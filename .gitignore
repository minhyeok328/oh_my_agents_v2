# Dependencies
node_modules/

# Environment files with real local secrets
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build and cache artifacts
dist/
build/
.next/
out/
coverage/
.cache/
.tmp/

# App workspaces are managed as separate Git repositories
/workspaces/*
!/workspaces/README.md
!/workspaces/sample-app/
!/workspaces/sample-app/.agent/
!/workspaces/sample-app/.agent/**
!/workspaces/sample-app/package.json
!/workspaces/sample-app/src/
!/workspaces/sample-app/src/**
!/workspaces/sample-app/tests/
!/workspaces/sample-app/tests/**

# OS and editor files
.DS_Store
.idea/
.vscode/
